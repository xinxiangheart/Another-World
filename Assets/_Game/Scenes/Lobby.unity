    - target: {fileID: 5849067024628715632, guid: 60f73560ffe107044a90a87ff927a23e, type: 3}
      propertyPath: m_text
      value: "\u53EC\u5524\u7269\u7279\u6027\uFF1A\n1.\u56FA\u6709\u7279\u6027\uFF1A\u4E00\u822C\u59CB\u7EC8\u751F\u6548\n2.\u8FDB\u573A\uFF1A\u53EC\u5524\u7269\u653E\u7F6E\u4E8E\u573A\u4E0A\u65F6\u89E6\u53D1\n3.\u9000\u573A\uFF1A\u53EC\u5524\u7269\u79BB\u5F00\u573A\u5185\u65F6\u89E6\u53D1\n4.\u4E3B\u52A8\u9000\u573A\uFF1A\u53EC\u5524\u7269\u56E0\u5176\u5B83\u53EC\u5524\u7269\u7279\u6027\u548C\u6CD5\u672F\u6548\u679C\u9000\u573A\u65F6\u89E6\u53D1\uFF0C\u89E6\u53D1\u4E3B\u52A8\u9000\u573A\u65F6\u4E0D\u89E6\u53D1\u9000\u573A\n5.\u53CD\u51FB\uFF1A\u53EC\u5524\u7269\u56E0\u5176\u5B83\u53EC\u5524\u7269\u653B\u51FB\u4F24\u5BB3\u548C\u7279\u6027\u4F24\u5BB3\u9000\u573A\u65F6\u89E6\u53D1\n6.\u5148\u624B\uFF1A\u653B\u51FB\u56DE\u5408\u5148\u624B\u9636\u6BB5\u89E6\u53D1\n7.\u9644\u7740\uFF1A\uFF08\u57FA\u7840\u751F\u547D\u503C>0\u65F6\u5141\u8BB8\u72EC\u7ACB\u653E\u7F6E\uFF09\u5141\u8BB8\u9644\u7740\u5728\u573A\u4E0A\u7684\u53EC\u5524\u7269\u8EAB\u4E0A\uFF0C\u9644\u7740\u65F6\u89E6\u53D1\u9644\u7740\u7279\u6027\uFF0C\u9644\u7740\u65F6\u4E0D\u53D7\u5230\u4F24\u5BB3\uFF0C\u4E0D\u89C6\u4E3A\u5B58\u6D3B\u4EBA\u6570\uFF0C\u4E5F\u4E0D\u653B\u51FB\uFF0C\u5BBF\u4E3B\u9000\u573A\u65F6\u968F\u4E4B\u9000\u573A\uFF08\u9000\u573A\u6765\u6E90\u662F\u5BBF\u4E3B\uFF09"
      objectReference: {fileID: 0}
