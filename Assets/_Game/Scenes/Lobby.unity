    - target: {fileID: 5849067024628715632, guid: 60f73560ffe107044a90a87ff927a23e, type: 3}
      propertyPath: m_text
      value: "1.\u5DF1\u65B9\u73A9\u5BB6\u751F\u547D\u503C\u548C\u80FD\u91CF\u663E\u793A\n2.\u5BF9\u65B9\u73A9\u5BB6\u751F\u547D\u503C\u548C\u80FD\u91CF\u663E\u793A\n3.\u624B\u724C\u533A\u57DF\uFF0C\u663E\u793A\u83B7\u5F97\u7684\u5361\u724C\n4.\u9690\u85CF\u6309\u94AE\uFF0C\u70B9\u51FB\u4E34\u65F6\u9690\u85CF\u624B\u724C\uFF0C\u4FBF\u4E8E\n\u89C2\u5BDF\u573A\u4E0A\u5C40\u52BF\uFF0C\u518D\u6B21\u70B9\u51FB\u663E\u73B0\n5.\u7ED3\u675F\u56DE\u5408\u6309\u94AE\uFF0C\u7ED3\u675F\u81EA\u5DF1\u7684\u56DE\u5408\n6.\u62BD\u724C\u6309\u94AE\uFF0C\u4ECE\u4E3B\u724C\u5E93\u62BD\u53D6\u4E00\u5F20\u724C\uFF0C\u6BCF\u56DE\u5408\u9650\u52365\u6B21\n\uFF08\u724C\u5E93\u5206\u4E3A\uFF1A\u4E3B\u724C\u5E93\uFF0C\u795E\u9009\u8005\u724C\u5E93\uFF0C\u7279\u6B8A\u724C\u5E93\uFF0C\u4E0D\u540C\u724C\u5E93\u4E4B\u95F4\u4E0D\u4E92\u901A\uFF0C\u65E0\u7279\u6B8A\u8BF4\u660E\u5747\u4ECE\u4E3B\u724C\u5E93\u62BD\u53D6\uFF09\n\u6BCF\u56DE\u5408\u7B2C\u4E00\u6B21\u62BD\u724C\u4F1A\u4ECE\u724C\u5E93\u4E2D\u524D\u4E09\u5F20\u9009\u62E9\u83B7\u53D6\u4E00\u5F20\uFF0C\u89C6\u4E3A\u201C\u62E9\u724C\u201D\n7.\u663E\u793A\u5F53\u524D\u56DE\u5408\u4EE5\u53CA\u672C\u9636\u6BB5\u5148\u624B\n"
